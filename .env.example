# ---------------------------------------------------------------------------
# Tiny CRM — copy to .env and fill in.
# ---------------------------------------------------------------------------

# SQLite for local development. Point this at a postgres:// connection string
# and run `npm run db:use-postgres` to promote to PostgreSQL — the schema is
# written to run unchanged on both.
DATABASE_URL="file:./dev.db"

# Session signing key. Generate one with: openssl rand -base64 32
# Required in production; development falls back to a fixed dev secret.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Tiny AI
#
# Leave both keys blank to run the built-in reasoning engine. It is not a stub:
# relationship strength, deal momentum, win probability, project health,
# go/no-go calls and every hygiene check are computed by the application and are
# exact either way. A key adds prose and open-ended questions.
#
# AI_PROVIDER: auto | anthropic | openai | offline
# ---------------------------------------------------------------------------
AI_PROVIDER="auto"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Optional: absolute URL used for metadata and OG images.
# NEXT_PUBLIC_SITE_URL="https://tinycrm.app"

# Optional: PostgreSQL connection pool ceiling.
# DATABASE_POOL_MAX="10"
