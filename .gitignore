# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local database
/dev.db
/dev.db-journal
*.db-shm
*.db-wal

# Local file storage
/storage

# Prisma agent skills (regenerated by `prisma init`)
/.agents
/.windsurf

# Throwaway databases created by the test and performance runners
test.db
test.db-*
perf.db
perf.db-*
build.db

# Embedded PostgreSQL cluster used by the verification runs
.pgdata/
.pgdata-run/

# Development mail sink
.mail/

.backup-test/
