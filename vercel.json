{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "pdx1"
  ],
  "buildCommand": "node scripts/deploy-gate.mjs && node scripts/use-provider.mjs auto && prisma generate && next build",
  "crons": [
    {
      "path": "/api/cron/jobs",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/jobs?sweep=1",
      "schedule": "17 4 * * *"
    }
  ]
}
