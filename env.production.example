# Tiny CRM — production environment
#
# Copy into your platform's secret manager. Do NOT commit a filled-in copy:
# `.env*` is git-ignored, and CI scans the full history for credentials.
#
# Verify before routing traffic:
#
#   NODE_ENV=production npm run check:config
#
# That runs the same gate `src/instrumentation.ts` runs at boot, and lists every
# problem at once rather than one per deploy. A server whose configuration is
# unsafe refuses to start; it does not start and serve requests insecurely.
#
# Values below marked REQUIRED are refused if missing or wrong.


# =============================================================================
# CORE
# =============================================================================

# REQUIRED. Anything else and the production gate does not run at all.
NODE_ENV=production

# REQUIRED. The canonical origin. Used for cookies, redirects, absolute links in
# email, and the OAuth callback if a provider is added later.
# The gate refuses HTTP and refuses localhost.
APP_URL=https://crm.example.com

# Identifies this build in logs and error reports. Most platforms set a commit
# SHA automatically; VERCEL_GIT_COMMIT_SHA is read as a fallback.
APP_RELEASE=

# How many instances of the application run. Declared, not detected — a process
# cannot see its siblings, and this is exactly what decides whether an
# in-process rate limiter is a control or a decoration.
# The gate refuses APP_INSTANCES > 1 without a shared rate-limit store.
APP_INSTANCES=1


# =============================================================================
# DATABASE
# =============================================================================

# REQUIRED. PostgreSQL 15+. The gate refuses a SQLite file in production.
#
# Before the first deploy:
#   npm run db:use-postgres && npx prisma generate
#   npx prisma migrate deploy
#   psql "$DATABASE_URL" -f prisma/postgres/001_search_indexes.sql
#   psql "$DATABASE_URL" -f prisma/postgres/002_row_level_security.sql
#   psql "$DATABASE_URL" -f prisma/postgres/003_deferrable_constraints.sql
#
# The three .sql files are not optional:
#   001  trigram indexes — without them substring search is a sequential scan
#   002  row-level security — the second tenant-isolation layer
#   003  deferrable constraints — without them a logical restore is impossible,
#        because Company and Contact reference each other
DATABASE_URL=postgresql://tinycrm_app:REPLACE_ME@db.internal:5432/tinycrm?sslmode=require

# Connections per instance. Set to (host connection limit / APP_INSTANCES),
# leaving headroom for migrations and the worker.
DATABASE_POOL_MAX=10

# Connect as the RLS-restricted role, not as the owner.
#
# A superuser bypasses row-level security even on a table marked FORCE, and the
# table owner can alter its own policies. `002_row_level_security.sql` creates
# `tinycrm_app` with NOBYPASSRLS for exactly this. Give it a password out of
# band, then point DATABASE_URL at it — the startup log says at error level when
# the connection is not actually protected.


# =============================================================================
# AUTHENTICATION
# =============================================================================

# REQUIRED. Signs session tokens. Generate with:
#   openssl rand -base64 32
#
# The gate refuses: missing, shorter than 32 characters, or the published
# development value. Rotating it signs every user out — deliberate, and worth
# planning rather than discovering.
AUTH_SECRET=

# Never set in production. Each of these is refused by the gate, and each is a
# complete authentication bypass or a data-destruction risk:
#   ALLOW_DEMO_AUTH        a one-click login with a published password
#   SEED_ALLOW_PRODUCTION  lets the demo seed wipe the database
#   TINYCRM_TEST_IDENTITY  acts as any user, with no credential at all
# ALLOW_DEMO_AUTH=
# SEED_ALLOW_PRODUCTION=
# TINYCRM_TEST_IDENTITY=


# =============================================================================
# RATE LIMITING
# =============================================================================

# Pick one. `auto` uses Redis when a URL is set, otherwise in-process memory.
# Memory is per-instance and resets on deploy: on more than one instance an
# attacker gets N times every limit.
#   auto | redis | postgres | memory
RATE_LIMIT_BACKEND=auto

# Upstash REST, or any Redis speaking it. Preferred: no write load on the
# primary, and it is the only option that stays cheap under an attack.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# Or share counters through the database you already have. A genuinely
# distributed limiter with no second piece of infrastructure, at the cost of a
# write per check. Requires PostgreSQL.
# RATE_LIMIT_BACKEND=postgres


# =============================================================================
# AI
# =============================================================================

# Which provider, if any. With no key the deterministic engine runs and NO CRM
# content leaves the deployment — scoring, momentum, stall detection, the
# cleanup scan and the daily brief all keep working.
#   auto | anthropic | openai | offline
AI_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Set ONLY if this deployment actually holds an enterprise or zero-retention
# agreement with the provider above.
#
# It is never inferred. A provider offering such an arrangement says nothing
# about whether this account has one, and workspaces set to "private model only"
# fail closed — sending nothing — until this is true.
AI_ENTERPRISE_AGREEMENT=false

# Include AI prompt text in logs. Development only; prompts carry CRM content.
LOG_AI_PROMPTS=false


# =============================================================================
# EMAIL
# =============================================================================

# Without a provider there is no password reset and no email verification, and
# the verification gate is not enforced — because enforcing a check nobody can
# satisfy would lock every account out of exports and invitations.
#
# Any provider taking a JSON POST with a bearer token: Resend, Postmark,
# SendGrid, Mailgun.
MAIL_PROVIDER_URL=https://api.resend.com/emails
MAIL_PROVIDER_TOKEN=
MAIL_FROM=Tiny CRM <no-reply@crm.example.com>

# The development sink writes reset links to a local file and the terminal. It
# refuses to run in production, and the no-provider fallback deliberately logs
# that a message *would* have been sent WITHOUT the link — a reset link is a
# bearer credential for an account and must not reach a log aggregator.
# MAIL_ADAPTER=


# =============================================================================
# STORAGE
# =============================================================================

# Uploads are disabled at `none`, which is the shipped state. The validation
# that will gate them exists and is tested (extension allowlist, magic bytes,
# generated storage keys, attachment-only downloads) — but there is NO MALWARE
# SCANNER. Wire one into scanForMalware() before enabling uploads.
#   none | local | s3
STORAGE_DRIVER=none
STORAGE_BUCKET=

# Fails uploads closed until a scanner is actually configured, so a deployment
# that believes it is scanning cannot accept an unscanned file.
REQUIRE_MALWARE_SCAN=true


# =============================================================================
# OBSERVABILITY
# =============================================================================

# Pick at most one. Without any, exceptions go to structured logs only —
# which is a floor, not a monitoring strategy.
#
# The payload is built from an explicit allowlist (type, message, stack, request
# id, route, user and workspace ids) rather than by an SDK's automatic
# instrumentation, which would capture request bodies and local variables — for
# this application, contact details, deal values and the text of private notes.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_DRAIN_URL=

#   debug | info | warn | error
LOG_LEVEL=info


# =============================================================================
# SECURITY ALERTING
# =============================================================================

# Where high-signal security events go. Slack, Discord, PagerDuty and Opsgenie
# all accept a JSON POST. Without it, alerts are recorded in the database and
# logged, and nobody is woken.
#
# The payload carries a kind, a severity, a count and an id — never CRM content.
# Whoever receives it looks the rest up somewhere with access control; an
# alerting channel usually has none.
ALERT_WEBHOOK_URL=
#   info | warning | critical
ALERT_MIN_SEVERITY=warning


# =============================================================================
# BILLING
# =============================================================================

# Shared secret the provider signs webhooks with. Plan changes are applied ONLY
# by a verified webhook — there is no browser-reachable action that changes a
# plan, and a test asserts its absence. Without this, no plan change can be
# applied at all.
BILLING_WEBHOOK_SECRET=


# =============================================================================
# BACKGROUND WORKER
# =============================================================================

# Set on the worker process, not on the web instances.
#
#   npm run worker            long-running, lowest latency
#   npm run worker -- --once  one pass, for cron or a scheduled function
#
# Without a worker running somewhere, automations only fire when a request
# happens to drain the outbox, and nothing sweeps expired sessions, tokens,
# rate-limit counters or scheduled workspace deletions.
WORKER_POLL_MS=2000
WORKER_IDLE_POLL_MS=10000
WORKER_BATCH=10
WORKER_SWEEP_MS=900000

# Shared secret for POST/GET /api/cron/jobs — the HTTP form of the worker, for
# platforms with no long-lived process (Vercel and every other serverless host).
#
#   openssl rand -base64 32
#
# On such a platform this is REQUIRED: without it the endpoint returns 503 and
# nothing ever drains the outbox, so automations, scheduled workspace deletions,
# overdue-task notifications and retention sweeps silently never happen. The
# endpoint refuses to run unauthenticated rather than failing open.
#
# Do NOT set this on preview deployments — a preview must never process the
# production queue. See docs/VERCEL-DEPLOYMENT.md.
CRON_SECRET=


# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Flags are stored in the database (FeatureFlag) and evaluated on the server, so
# they can gate a security-sensitive capability. A NEXT_PUBLIC_ variable is
# visible to and editable by the client and is therefore never a control — a
# test asserts none is used for one.
#
# Defaults: ai on, automations on, files off, integrations off,
#           experimentalSearch off, auditLogUi on.
