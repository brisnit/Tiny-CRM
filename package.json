{
  "name": "tiny-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:use-postgres": "node scripts/use-provider.mjs postgresql",
    "db:use-sqlite": "node scripts/use-provider.mjs sqlite",
    "postinstall": "prisma generate",
    "db:loadtest": "NODE_OPTIONS=\"--require ./scripts/allow-server-modules.cjs\" tsx scripts/loadtest.ts",
    "db:loadtest:clean": "NODE_OPTIONS=\"--require ./scripts/allow-server-modules.cjs\" tsx scripts/loadtest.ts --clean",
    "test": "node scripts/run-tests.mjs",
    "test:security": "node scripts/run-tests.mjs \"tests/security/**/*.test.ts\"",
    "test:perf": "node scripts/run-perf.mjs",
    "check:config": "tsx scripts/check-config.ts",
    "test:pg": "node scripts/run-tests-pg.mjs",
    "pg": "node scripts/pg.mjs",
    "db:differences": "tsx scripts/db-differences.ts",
    "db:seed:test": "tsx prisma/seed/test-seed.ts",
    "test:backup": "node scripts/backup-test.mjs",
    "worker": "NODE_OPTIONS=\"--require ./scripts/allow-server-modules.cjs\" tsx scripts/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.10.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg-copy-streams": "^7.0.0",
    "playwright": "^1.63.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "description": "Your whole business. Organized. A simple AI-powered CRM for contacts, deals, projects, tasks, and everything that happens between them."
}
